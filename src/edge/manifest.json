{
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "*://item.jd.com/*",
    "http://localhost:8989/*"
  ],
  "name": "罗睺镜",
  "version": "1.2",
  "description": "为网页防刷单提供信息",
  "action": {
      "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://item.jd.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
